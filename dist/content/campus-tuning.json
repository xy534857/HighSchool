{
  "actions": {
    "accept-offer": {
      "attention": "none",
      "category": "response",
      "cooldown": 0,
      "duration": 0,
      "effects": [
        {
          "offer": "$offer.id",
          "status": "accepted",
          "type": "offer.resolve"
        }
      ],
      "executor": "speech",
      "label": "好，就这么说定了",
      "roles": {
        "offer": {
          "from": "offers",
          "where": {
            "all": [
              {
                "left": "$bound.to",
                "op": "eq",
                "right": "$actor.id"
              },
              {
                "left": "$bound.status",
                "op": "eq",
                "right": "pending"
              }
            ]
          }
        }
      },
      "when": {
        "left": "$actor.hasFloor",
        "op": "eq",
        "right": true
      }
    },
    "answer-known": {
      "attention": "none",
      "category": "answer",
      "cooldown": 0,
      "duration": 0,
      "effects": [
        {
          "key": "$message.key",
          "replyTo": "$message.uid",
          "to": "$message.actor",
          "type": "knowledge.tell"
        }
      ],
      "executor": "speech",
      "label": "把自己知道的情况告诉对方",
      "roles": {
        "message": {
          "from": "messages",
          "where": {
            "all": [
              {
                "left": "$bound.answered",
                "op": "eq",
                "right": false
              },
              {
                "left": "$bound.known",
                "op": "eq",
                "right": true
              }
            ]
          }
        }
      },
      "when": {
        "left": "$actor.hasFloor",
        "op": "eq",
        "right": true
      }
    },
    "answer-unknown": {
      "attention": "none",
      "category": "answer",
      "cooldown": 0,
      "duration": 0,
      "effects": [
        {
          "replyTo": "$message.uid",
          "to": "$message.actor",
          "type": "speech.emit"
        }
      ],
      "executor": "speech",
      "label": "我还不清楚",
      "roles": {
        "message": {
          "from": "messages",
          "where": {
            "all": [
              {
                "left": "$bound.answered",
                "op": "eq",
                "right": false
              },
              {
                "left": "$bound.known",
                "op": "eq",
                "right": false
              }
            ]
          }
        }
      },
      "when": {
        "left": "$actor.hasFloor",
        "op": "eq",
        "right": true
      }
    },
    "ask-loan": {
      "attention": "none",
      "cooldown": 20,
      "duration": 0,
      "effects": [
        {
          "due": "$args.due",
          "giver": "$target.id",
          "item": "$item.id",
          "kind": "loan",
          "receiver": "$actor.id",
          "to": "$target.id",
          "type": "offer.create"
        }
      ],
      "executor": "speech",
      "label": "想借这份笔记，稍后归还",
      "parameters": {
        "due": {
          "default": 600,
          "max": 100000,
          "min": 0,
          "type": "number"
        }
      },
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "loanable"
          }
        },
        "target": {
          "from": "actors"
        }
      },
      "when": {
        "all": [
          {
            "left": "$actor.hasFloor",
            "op": "eq",
            "right": true
          },
          {
            "left": "$target.session",
            "op": "eq",
            "right": "$actor.session"
          },
          {
            "left": "$item.holder",
            "op": "eq",
            "right": "$target.id"
          }
        ]
      }
    },
    "ask-question": {
      "attention": "none",
      "cooldown": 5,
      "duration": 0,
      "effects": [
        {
          "data": {
            "key": "$args.key"
          },
          "kind": "question",
          "text": "$args.text",
          "to": "$target.id",
          "type": "speech.emit"
        }
      ],
      "executor": "speech",
      "label": "问清楚刚才的事情",
      "parameters": {
        "key": {
          "type": "string"
        },
        "text": {
          "default": "这件事是怎么说的？",
          "type": "string"
        }
      },
      "roles": {
        "target": {
          "from": "actors"
        }
      },
      "when": {
        "all": [
          {
            "left": "$actor.hasFloor",
            "op": "eq",
            "right": true
          },
          {
            "left": "$target.session",
            "op": "eq",
            "right": "$actor.session"
          }
        ]
      }
    },
    "decline-conversation": {
      "attention": "none",
      "category": "invitation",
      "cooldown": 0,
      "duration": 0,
      "effects": [
        {
          "decline": true,
          "session": "$invitation.session",
          "type": "session.leave"
        }
      ],
      "executor": "instant",
      "label": "暂时不聊",
      "roles": {
        "invitation": {
          "from": "invitations"
        }
      }
    },
    "decline-offer": {
      "attention": "none",
      "category": "response",
      "cooldown": 0,
      "duration": 0,
      "effects": [
        {
          "offer": "$offer.id",
          "status": "declined",
          "type": "offer.resolve"
        }
      ],
      "executor": "speech",
      "label": "这次不能答应",
      "roles": {
        "offer": {
          "from": "offers",
          "where": {
            "all": [
              {
                "left": "$bound.to",
                "op": "eq",
                "right": "$actor.id"
              },
              {
                "left": "$bound.status",
                "op": "eq",
                "right": "pending"
              }
            ]
          }
        }
      },
      "when": {
        "left": "$actor.hasFloor",
        "op": "eq",
        "right": true
      }
    },
    "drink": {
      "anchor": "$item",
      "attention": "pause",
      "cooldown": 30,
      "duration": 1,
      "effects": [
        {
          "amount": 4,
          "need": "energy",
          "type": "need.change"
        }
      ],
      "executor": "physical",
      "label": "喝水",
      "needThreshold": 35,
      "pose": "standing",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "drink"
          }
        }
      },
      "slot": "drink",
      "when": {
        "left": "$actor.session",
        "op": "eq",
        "right": null
      }
    },
    "eat": {
      "anchor": "$item",
      "attention": "pause",
      "cooldown": 30,
      "duration": 6,
      "effects": [
        {
          "type": "object.add",
          "object": "$item.id",
          "field": "servings",
          "amount": -1,
          "min": 0
        },
        {
          "amount": 45,
          "need": "hunger",
          "type": "need.change"
        }
      ],
      "executor": "physical",
      "label": "吃饭",
      "need": "hunger",
      "needThreshold": 35,
      "pose": "sitting",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "eat"
          }
        }
      },
      "slot": "eat",
      "when": {
        "left": "$actor.session",
        "op": "eq",
        "right": null
      },
      "requires": {
        "op": "gt",
        "left": "$item.state.servings",
        "right": 0
      }
    },
    "hand-over": {
      "anchor": "$target",
      "attention": "none",
      "cooldown": 0,
      "duration": 0.5,
      "effects": [
        {
          "authorization": "$offer.id",
          "from": "$actor.id",
          "object": "$item.id",
          "to": "$target.id",
          "type": "object.transfer"
        }
      ],
      "executor": "physical",
      "label": "把物品交给对方",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.id",
            "op": "eq",
            "right": "$offer.item"
          }
        },
        "offer": {
          "from": "offers",
          "where": {
            "all": [
              {
                "left": "$bound.status",
                "op": "eq",
                "right": "accepted"
              },
              {
                "left": "$bound.giver",
                "op": "eq",
                "right": "$actor.id"
              },
              {
                "left": "$bound.transferred",
                "op": "eq",
                "right": false
              }
            ]
          }
        },
        "target": {
          "from": "actors",
          "where": {
            "left": "$bound.id",
            "op": "eq",
            "right": "$offer.receiver"
          }
        }
      },
      "when": {
        "left": "$item.holder",
        "op": "eq",
        "right": "$actor.id"
      }
    },
    "inspect": {
      "anchor": "$item",
      "attention": "none",
      "cooldown": 5,
      "duration": 1,
      "effects": [
        {
          "object": "$item.id",
          "type": "object.inspect"
        }
      ],
      "executor": "physical",
      "label": "查看物品",
      "roles": {
        "item": {
          "from": "objects"
        }
      }
    },
    "invite-group": {
      "attention": "none",
      "cooldown": 5,
      "duration": 0,
      "effects": [
        {
          "group": "$group.id",
          "type": "session.invite"
        }
      ],
      "executor": "instant",
      "label": "邀请小组一起聊",
      "roles": {
        "group": {
          "from": "groups"
        }
      },
      "when": {
        "left": "$actor.session",
        "op": "ne",
        "right": null
      }
    },
    "invite-into-conversation": {
      "attention": "none",
      "cooldown": 5,
      "duration": 0,
      "effects": [
        {
          "target": "$target.id",
          "type": "session.invite"
        }
      ],
      "executor": "instant",
      "label": "叫同学一起聊",
      "roles": {
        "target": {
          "from": "actors"
        }
      },
      "when": {
        "all": [
          {
            "left": "$actor.session",
            "op": "ne",
            "right": null
          },
          {
            "left": "$target.session",
            "op": "ne",
            "right": "$actor.session"
          }
        ]
      }
    },
    "join-conversation": {
      "attention": "none",
      "category": "invitation",
      "cooldown": 0,
      "defaultPriority": 30,
      "duration": 0,
      "effects": [
        {
          "session": "$invitation.session",
          "type": "session.join"
        }
      ],
      "executor": "instant",
      "label": "加入交谈",
      "roles": {
        "invitation": {
          "from": "invitations"
        }
      },
      "when": {
        "all": [
          {
            "left": "$actor.session",
            "op": "eq",
            "right": null
          },
          {
            "left": "$actor.interruptible",
            "op": "eq",
            "right": true
          }
        ]
      }
    },
    "leave-conversation": {
      "attention": "none",
      "cooldown": 0,
      "duration": 0,
      "effects": [
        {
          "type": "session.leave"
        }
      ],
      "executor": "instant",
      "label": "先去忙了",
      "roles": {},
      "when": {
        "left": "$actor.session",
        "op": "ne",
        "right": null
      }
    },
    "make-group": {
      "attention": "none",
      "cooldown": 10,
      "duration": 0,
      "effects": [
        {
          "invited": [
            "$target.id"
          ],
          "name": "$args.name",
          "type": "group.create"
        }
      ],
      "executor": "instant",
      "label": "组织一个学习小组",
      "parameters": {
        "name": {
          "default": "学习小组",
          "type": "string"
        }
      },
      "roles": {
        "target": {
          "from": "actors"
        }
      }
    },
    "offer-meeting": {
      "attention": "none",
      "cooldown": 20,
      "duration": 0,
      "effects": [
        {
          "due": "$args.due",
          "kind": "meeting",
          "to": "$target.id",
          "type": "offer.create"
        }
      ],
      "executor": "speech",
      "label": "约个时间一起参加活动",
      "parameters": {
        "due": {
          "default": 1020,
          "max": 100000,
          "min": 0,
          "type": "number"
        }
      },
      "roles": {
        "target": {
          "from": "actors"
        }
      },
      "when": {
        "all": [
          {
            "left": "$actor.hasFloor",
            "op": "eq",
            "right": true
          },
          {
            "left": "$target.session",
            "op": "eq",
            "right": "$actor.session"
          }
        ]
      }
    },
    "pick-up": {
      "anchor": "$item",
      "attention": "none",
      "cooldown": 1,
      "duration": 0.5,
      "effects": [
        {
          "object": "$item.id",
          "type": "object.take"
        }
      ],
      "executor": "physical",
      "label": "拿起物品",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "portable"
          }
        }
      },
      "when": {
        "left": "$item.holder",
        "op": "eq",
        "right": null
      }
    },
    "put-down": {
      "attention": "none",
      "cooldown": 1,
      "duration": 0,
      "effects": [
        {
          "object": "$item.id",
          "type": "object.put"
        }
      ],
      "executor": "instant",
      "label": "放下物品",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "portable"
          }
        }
      },
      "when": {
        "left": "$item.holder",
        "op": "eq",
        "right": "$actor.id"
      }
    },
    "rest": {
      "anchor": "$item",
      "attention": "pause",
      "cooldown": 30,
      "duration": 10,
      "effects": [
        {
          "amount": 50,
          "need": "energy",
          "type": "need.change"
        }
      ],
      "executor": "physical",
      "label": "休息",
      "need": "energy",
      "needThreshold": 35,
      "pose": "sleeping",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "rest"
          }
        }
      },
      "slot": "rest",
      "when": {
        "left": "$actor.session",
        "op": "eq",
        "right": null
      }
    },
    "return-loan": {
      "anchor": "$target",
      "attention": "none",
      "cooldown": 0,
      "duration": 0.5,
      "effects": [
        {
          "authorization": "$offer.id",
          "from": "$actor.id",
          "object": "$item.id",
          "return": true,
          "to": "$target.id",
          "type": "object.transfer"
        },
        {
          "appointment": "$offer.appointment",
          "type": "appointment.fulfill",
          "when": {
            "left": "$item.holder",
            "op": "eq",
            "right": "$target.id"
          }
        }
      ],
      "executor": "physical",
      "label": "按约把借来的物品还给对方",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.id",
            "op": "eq",
            "right": "$offer.item"
          }
        },
        "offer": {
          "from": "offers",
          "where": {
            "all": [
              {
                "left": "$bound.status",
                "op": "eq",
                "right": "accepted"
              },
              {
                "left": "$bound.receiver",
                "op": "eq",
                "right": "$actor.id"
              },
              {
                "left": "$bound.transferred",
                "op": "eq",
                "right": true
              },
              {
                "not": {
                  "left": "$bound.returned",
                  "op": "eq",
                  "right": true
                }
              }
            ]
          }
        },
        "target": {
          "from": "actors",
          "where": {
            "left": "$bound.id",
            "op": "eq",
            "right": "$offer.giver"
          }
        }
      },
      "when": {
        "left": "$item.holder",
        "op": "eq",
        "right": "$actor.id"
      }
    },
    "say": {
      "attention": "none",
      "cooldown": 1,
      "duration": 0,
      "effects": [
        {
          "text": "$args.text",
          "to": "$target.id",
          "type": "speech.emit"
        }
      ],
      "executor": "speech",
      "label": "说说话",
      "parameters": {
        "text": {
          "type": "string"
        }
      },
      "roles": {
        "target": {
          "from": "actors"
        }
      },
      "when": {
        "all": [
          {
            "left": "$actor.hasFloor",
            "op": "eq",
            "right": true
          },
          {
            "left": "$target.session",
            "op": "eq",
            "right": "$actor.session"
          }
        ]
      }
    },
    "start-conversation": {
      "anchor": "$target",
      "attention": "none",
      "cooldown": 5,
      "duration": 0.1,
      "effects": [
        {
          "access": "$args.access",
          "target": "$target.id",
          "topic": "$args.topic",
          "type": "session.open"
        }
      ],
      "executor": "physical",
      "label": "过去聊聊",
      "parameters": {
        "access": {
          "default": "public",
          "enum": [
            "public",
            "private"
          ],
          "type": "string"
        },
        "topic": {
          "default": "课间聊聊",
          "type": "string"
        }
      },
      "roles": {
        "target": {
          "from": "actors"
        }
      },
      "when": {
        "left": "$actor.session",
        "op": "eq",
        "right": null
      }
    },
    "study": {
      "anchor": "$item",
      "attention": "pause",
      "cooldown": 10,
      "duration": 8,
      "effects": [
        {
          "amount": -1,
          "need": "social",
          "type": "need.change"
        },
        {
          "kind": "study-progress",
          "text": "完成了一段学习。",
          "type": "event.emit"
        }
      ],
      "executor": "physical",
      "label": "学习",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "study"
          }
        }
      },
      "slot": "study",
      "when": {
        "left": "$actor.session",
        "op": "eq",
        "right": null
      }
    },
    "toilet": {
      "anchor": "$item",
      "attention": "pause",
      "cooldown": 30,
      "duration": 3,
      "effects": [
        {
          "amount": 70,
          "need": "bladder",
          "type": "need.change"
        }
      ],
      "executor": "physical",
      "label": "上厕所",
      "need": "bladder",
      "needThreshold": 35,
      "pose": "sitting",
      "roles": {
        "item": {
          "from": "objects",
          "where": {
            "left": "$bound.tags",
            "op": "includes",
            "right": "toilet"
          }
        }
      },
      "slot": "toilet",
      "when": {
        "left": "$actor.session",
        "op": "eq",
        "right": null
      }
    },
    "wait": {
      "attention": "none",
      "cooldown": 0,
      "duration": 0,
      "effects": [],
      "executor": "instant",
      "fallback": true,
      "label": "等一会儿",
      "roles": {}
    }
  },
  "clock": {
    "periods": [
      {
        "end": 510,
        "id": "morning",
        "start": 420
      },
      {
        "end": 720,
        "id": "class",
        "start": 510
      },
      {
        "end": 780,
        "id": "lunch",
        "start": 720
      },
      {
        "end": 960,
        "id": "class",
        "start": 780
      },
      {
        "end": 1140,
        "id": "after-school",
        "start": 960
      },
      {
        "end": 1440,
        "id": "night",
        "start": 1140
      }
    ],
    "step": 0.5,
    "walkSpeed": 2
  },
  "id": "campus-foundation-v1",
  "limits": {
    "inviteMinutes": 8,
    "maxParticipants": 10,
    "maxTurns": 40,
    "offerMinutes": 15,
    "sessionMinutes": 40,
    "turnMinutes": 1
  },
  "needs": {
    "decay": {
      "bladder": 0.1,
      "energy": 0.08,
      "hunger": 0.12,
      "social": 0.04
    },
    "initial": {
      "bladder": 80,
      "energy": 85,
      "hunger": 80,
      "social": 70
    }
  },
  "predicates": {
    "holder": {
      "type": "string"
    },
    "pages": {
      "type": "number"
    },
    "status": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    }
  },
  "proposals": {
    "loan": {
      "accept": [
        {
          "kind": "return-item",
          "offer": "$offer.id",
          "type": "appointment.create"
        }
      ],
      "decline": [],
      "when": {
        "left": "$offer.giver",
        "op": "eq",
        "right": "$actor.id"
      },
      "rights": {
        "transfer": true,
        "return": true
      }
    },
    "meeting": {
      "accept": [
        {
          "kind": "meeting",
          "offer": "$offer.id",
          "type": "appointment.create"
        }
      ],
      "decline": []
    }
  },
  "routines": [
    {
      "action": "study",
      "id": "school-study",
      "priority": 100,
      "when": {
        "all": [
          {
            "left": "$clock.period",
            "op": "eq",
            "right": "class"
          },
