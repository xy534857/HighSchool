sp {mind*mark-revision
 (state <s> ^operator <o> ^context <c>) (<o> ^name revise-mind ^record <r>)
 (<c> ^frame.evidence.provenance <root>)
 --> (<c> ^mind-written yes) (<r> ^origin <root>)
}
sp {mind*store
 (state <s> ^context <c> ^smem.command <mc>) (<c> ^mind-written yes ^mental-record <r>)
 --> (<mc> ^store <r>)
}
sp {mind*ack-write
 (state <s> ^context <c> ^smem.result.success <r> ^io.output-link <out>)
 (<c> ^frame <f> ^mental-record <r> ^mind-written yes) (<f> ^seq <seq>)
 --> (<out> ^command <cmd>) (<cmd> ^seq <seq> ^kind interpreted ^record (deep-copy <r>) ^remember yes)
}
sp {mind*ack-duplicate
 (state <s> ^context <c> ^io.output-link <out>)
 (<c> ^frame <f> ^mental-record <r> ^duplicate yes) (<f> ^seq <seq>)
 --> (<out> ^command <cmd>) (<cmd> ^seq <seq> ^kind duplicate ^record (deep-copy <r>))
}
sp {mind*decay
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r>)
 (<f> ^mode mind-read ^time <now> ^emotion-decay <ed> ^mood-decay <md>)
 (<r> ^at <at> ^intensity <i> ^tension <t>)
 --> (<c> ^remaining (- <i> (* (- <now> <at>) <ed>)) ^background (- <t> (* (- <now> <at>) <md>)))
}
sp {mind*positive-emotion
 (state <s> ^context <c>) (<c> ^remaining { <r> > 0 }) --> (<c> ^active <r>)
}
sp {mind*quiet-emotion
 (state <s> ^context <c>) (<c> ^remaining <= 0) --> (<c> ^active 0)
}
sp {mind*positive-mood
 (state <s> ^context <c>) (<c> ^background { <r> > 0 }) --> (<c> ^mood <r>)
}
sp {mind*quiet-mood
 (state <s> ^context <c>) (<c> ^background <= 0) --> (<c> ^mood 0)
}
sp {mind*read-out
 (state <s> ^context <c> ^io.output-link <out>)
 (<c> ^frame <f> ^mental-record <r> ^active <a> ^mood <m>) (<f> ^seq <seq>)
 --> (<out> ^command <cmd>) (<cmd> ^seq <seq> ^kind mind ^record (deep-copy <r>) ^active <a> ^mood <m>)
}
# Epistemic actions use the same native operator competition as ordinary tasks.
sp {mind*seek-last-known-place
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes) (<f> ^mode act ^busy no ^seeking <> none ^available <a>)
 (<a> ^kind inspect ^last-known yes)
 --> (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 135 ^rule mind*seek-last-known-place ^reason |先去上次记得的位置找，不能凭空知道东西被挪去哪了。|)
}
sp {mind*search-other-places
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes) (<f> ^mode act ^busy no ^available <a>)
 (<a> ^kind inspect ^inspection-reason <> stale-empty)
 --> (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 125 ^rule mind*search-other-places ^reason |先查看实际物品，再接着安排手头的事。|)
}
sp {mind*verify-with-person
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes) (<f> ^mode act ^busy no ^affect <m> ^available <a>)
 (<m> ^coping verify ^active > 18 ^subject <who> ^domain <domain>) (<a> ^kind chat ^target <who>)
 --> (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 112 ^speech-act ask-reason ^topic <domain> ^rule mind*verify-with-person ^reason |我还不清楚对方的原因，找本人把情况问清楚。|)
}
sp {mind*withdraw-briefly
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes) (<f> ^mode act ^busy no ^affect <m> ^available <a>)
 (<m> ^coping withdraw ^active > 30) (<a> ^kind rest)
 --> (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 110 ^rule mind*withdraw-briefly ^reason |我现在有点顶着劲，先歇一下，原来的打算还留着。|)
}
sp {mind*discuss-specific-harm
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes) (<f> ^mode act ^busy no ^affect <m> ^available <a>)
 (<m> ^coping << discuss seek-company repair reciprocate >> ^active > 18 ^subject <who>) (<a> ^kind chat ^target <who>)
 --> (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 110 ^rule mind*discuss-specific-harm ^reason |这件事影响了我对他的感受，想和本人说说，再继续自己的安排。|)
}

sp {mind*bound-trust-high
 (state <s> ^context.revision <v>) (<v> ^trust-value > 100) --> (<v> ^judgment 100)
}
sp {mind*bound-trust-low
 (state <s> ^context.revision <v>) (<v> ^trust-value < 0) --> (<v> ^judgment 0)
}
sp {mind*bounded-trust
 (state <s> ^context.revision <v>) (<v> ^trust-value { <j> >= 0 <= 100 }) --> (<v> ^judgment <j>)
}
# A slower mood state still affects self-regulation after the acute emotion fades.
sp {mind*recover-from-lingering-tension
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes)
 (<f> ^mode act ^busy no ^energy < 65 ^meal-window no ^night no ^affect <m> ^available <a>)
 (<m> ^mood > 18 ^active < 10) (<a> ^kind rest)
 --> (<s> ^operator <o> +)
 (<o> ^name choose ^choice <a> ^priority 106 ^rule mind*recover-from-lingering-tension ^reason |已经没那么激动了，但余下的紧张还在，精力也不够。先休息一下，再接着原来的安排。|)
}

# ChatGPT revision from the seven-day run: Xing skipped three meals while remembering stock=0.
# Empty stock is a dated observation, not a permanent prohibition on checking the kitchen.
sp {mind*recheck-stale-empty-stock
 (state <s> ^context <c> ^io.input-link.frame <f>)
 (<c> ^goal-ready yes ^memory-ready yes) (<f> ^mode act ^busy no ^available <a>)
 (<a> ^kind inspect ^inspection-reason stale-empty ^known-age > 15)
 --> (<s> ^operator <o> +)
 (<o> ^name choose ^choice <a> ^priority 126 ^rule mind*recheck-stale-empty-stock ^reason |上次看见没饭已经过了一阵，先去厨房重新确认，不能一直凭旧印象等着。|)
}
