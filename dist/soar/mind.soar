# Native personal evidence revision, attribution and affect. The host supplies sensed events only.
sp {mind*query
 (state <s> ^context <c> ^smem.command <mc>)
 (<c> ^frame <f>) (<f> ^mode << perceive mind-read >> ^self <me> ^key <key>)
 -(<c> ^mind-ready yes)
 --> (<c> ^mind-query <q>) (<q> ^type mental-record ^owner <me> ^key <key>) (<mc> ^query <q>)
}
sp {mind*retrieve
 :o-support
 (state <s> ^context <c> ^smem.result <mr>) (<c> ^mind-query <q>)
 (<mr> ^success <q> ^retrieved <r>)
 --> (<c> ^mind-ready yes ^mental-record <r>)
}
sp {mind*create
 :o-support
 (state <s> ^context <c> ^smem.result.failure <q>)
 (<c> ^mind-query <q> ^frame <f>) (<f> ^self <me> ^key <key> ^subject <subject> ^predicate <predicate> ^domain <domain>)
 --> (<c> ^mind-ready yes ^mental-record <r>)
 (<r> ^type mental-record ^owner <me> ^key <key> ^subject <subject> ^predicate <predicate> ^domain <domain> ^value unknown ^status unknown ^provenance none ^informant none ^at 0 ^emotion neutral ^intensity 0 ^tension 0 ^judgment 50 ^reason no-evidence ^source none ^prior unknown ^coping continue ^conflict none)
}
sp {mind*same-origin-is-not-new-evidence
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r>)
 (<f> ^mode perceive ^evidence <e>) (<e> ^provenance <root>) (<r> ^origin <root>) -(<c> ^mind-written yes)
 --> (<c> ^duplicate yes)
}
sp {mind*init-next
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r>)
 (<f> ^mode perceive ^evidence <e>) -(<c> ^duplicate yes) -(<c> ^mind-written yes)
 --> (<c> ^next (deep-copy <r>))
}
sp {mind*first-or-direct-evidence
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r> ^next <n>)
 (<f> ^mode perceive ^evidence <e>)
 (<e> ^class belief ^source << seen self >> ^value <value> ^provenance <root> ^speaker <speaker> ^time <t>) (<n> ^value <prior>)
 --> (<c> ^revision <v>)
 (<v> ^value <value> ^status known ^provenance <root> ^informant <speaker> ^at <t> ^source seen ^prior <prior> ^emotion neutral ^intensity 0 ^tension 0 ^reason direct-observation ^coping continue ^conflict none)
}
sp {mind*direct-interaction-result
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r> ^next <n>)
 (<f> ^mode perceive ^evidence <e>)
 (<e> ^class interaction-result ^source << seen self heard >> ^value <value> ^provenance <root> ^speaker <speaker> ^time <t>) (<n> ^value <prior>)
 --> (<c> ^revision <v>)
 (<v> ^value <value> ^status known ^provenance <root> ^informant <speaker> ^at <t> ^source heard ^prior <prior> ^emotion neutral ^intensity 0 ^tension 0 ^reason witnessed-interaction-result ^coping continue ^conflict none)
}
sp {mind*new-testimony
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r> ^next <n>)
 (<f> ^mode perceive ^evidence <e>)
 (<e> ^class belief ^source heard ^value <value> ^provenance <root> ^speaker <speaker> ^time <t>) (<n> ^status unknown)
 --> (<c> ^revision <v>)
 (<v> ^value <value> ^status tentative ^provenance <root> ^informant <speaker> ^at <t> ^source heard ^reason single-source ^coping verify ^conflict none ^emotion uncertain ^intensity 20 ^tension 8)
}
sp {mind*consistent-testimony
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r> ^next <n>)
 (<f> ^mode perceive ^evidence <e>)
 (<e> ^class belief ^source heard ^value <value> ^provenance <root> ^speaker <speaker> ^time <t>) (<n> ^status <> unknown ^value <value>)
 --> (<c> ^revision <v>)
 (<v> ^reason same-claim-no-proof)
