sp {mind*correct-attribution
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r> ^next <n>)
 (<f> ^mode perceive ^evidence <e>)
 (<e> ^class social ^value correction ^provenance <root> ^speaker <speaker> ^time <t>) (<n> ^judgment <j> ^reason <old> ^value <prior>)
 --> (<c> ^revision <v>)
 (<v> ^value correction ^status known ^provenance <root> ^informant <speaker> ^at <t> ^source heard ^prior <prior> ^reason new-explanation-reappraised ^emotion relieved ^intensity 15 ^tension 6 ^trust-value (+ <j> 2) ^coping repair ^conflict none)
}
sp {mind*apology-specific
 (state <s> ^context <c>) (<c> ^frame <f> ^mental-record <r> ^next <n>)
 (<f> ^mode perceive ^evidence <e>)
 (<e> ^class social ^value apology ^provenance <root> ^speaker <speaker> ^time <t>) (<n> ^judgment <j> ^value <prior>)
 --> (<c> ^revision <v>)
 (<v> ^value apology ^status known ^provenance <root> ^informant <speaker> ^at <t> ^source heard ^prior <prior> ^reason acknowledged-specific-harm ^emotion relieved ^intensity 18 ^tension 10 ^trust-value (+ <j> 2) ^coping continue ^conflict none)
}
sp {mind*propose-revise
 (state <s> ^context <c>) (<c> ^revision <v> ^mental-record <r> ^frame <f>)
 -(<c> ^mind-written yes) -(<c> ^duplicate yes)
 --> (<s> ^operator <o> +) (<o> ^name revise-mind ^record <r> ^revision <v>)
}
sp {mind*apply-value
 (state <s> ^operator <o>) (<o> ^name revise-mind ^record <r> ^revision <v>)
 (<v> ^value <new>) (<r> ^value { <old> <> <new> })
 --> (<r> ^value <old> - ^value <new>)
}
sp {mind*apply-status
 (state <s> ^operator <o>) (<o> ^name revise-mind ^record <r> ^revision <v>)
 (<v> ^status <new>) (<r> ^status { <old> <> <new> })
 --> (<r> ^status <old> - ^status <new>)
}
sp {mind*apply-root
 (state <s> ^operator <o>) (<o> ^name revise-mind ^record <r> ^revision <v>)
 (<v> ^provenance <new>) (<r> ^provenance { <old> <> <new> })
 --> (<r> ^provenance <old> - ^provenance <new>)
}
sp {mind*apply-informant
 (state <s> ^operator <o>) (<o> ^name revise-mind ^record <r> ^revision <v>)
 (<v> ^informant <new>) (<r> ^informant { <old> <> <new> })
 --> (<r> ^informant <old> - ^informant <new>)
}
