# Explanations of excluded actions come from fired productions, not a prose guess.
sp {core*expose-active-constraint
 (state <s> ^context <c> ^io.output-link.command <cmd>)
 (<c> ^frame <f> ^constraint <constraint>) (<f> ^mode act ^seq <seq>) (<cmd> ^seq <seq>)
 --> (<cmd> ^constraints <constraint>)
}
# Several memories can support exactly the same action. Equivalent proposals must not impasse.
sp {core*equivalent-proposals
 (state <s> ^operator <a> + ^operator { <b> <> <a> } +)
 (<a> ^name choose ^priority <p> ^choice <c>) (<b> ^name choose ^priority <p> ^choice <c>)
 --> (<s> ^operator <a> = <b>)
}
