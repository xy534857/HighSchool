# Shared operators and body maintenance. Personality programs are loaded separately.
sp {core*prefer-higher-priority
 (state <s> ^operator <a> + ^operator <b> +)
 (<a> ^name choose ^priority <pa>)
 (<b> ^name choose ^priority { <pb> < <pa> })
 -->
 (<s> ^operator <a> > <b>)
}
sp {core*tie-break-by-affordance
 (state <s> ^operator <a> + ^operator <b> +)
 (<a> ^name choose ^priority <p> ^choice <ca>)
 (<b> ^name choose ^priority <p> ^choice <cb>)
 (<ca> ^ordinal <ia>)
 (<cb> ^ordinal { <ib> > <ia> })
 -->
 (<s> ^operator <a> > <b>)
}
sp {core*emit-selected-command
 :i-support
 (state <s> ^superstate nil ^operator <o> ^io.input-link.frame <f> ^io.output-link <out>)
 (<o> ^name choose ^choice <a> ^rule <rule> ^reason <reason>)
 (<f> ^mode act ^seq <seq> ^available <a>)
 (<a> ^id <id> ^kind <kind> ^target <target>)
 -->
 (<out> ^command <cmd>)
 (<cmd> ^seq <seq> ^id <id> ^kind <kind> ^target <target> ^rule <rule> ^reason <reason>)
}
sp {base*continue-intention
 (state <s> ^superstate nil ^io.input-link.frame <f> ^context <ctx>)
 (<ctx> ^frame <f> ^goal-ready yes ^memory-ready yes)
 (<f> ^mode act ^busy yes ^available <a>) (<a> ^kind continue)
 -->
 (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 60 ^rule base*continue-intention ^reason |先把正在做的事办完。|)
}
sp {base*wait-for-opportunity
 (state <s> ^superstate nil ^io.input-link.frame <f> ^context <ctx>)
 (<ctx> ^frame <f> ^goal-ready yes ^memory-ready yes)
 (<f> ^mode act ^available <a>) (<a> ^kind wait)
 -->
 (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority 0 ^rule base*wait-for-opportunity ^reason |等一个合适的空当。|)
}
sp {base*eat-when-hungry
 (state <s> ^superstate nil ^io.input-link.frame <f> ^context <ctx>)
 (<ctx> ^frame <f> ^goal-ready yes ^memory-ready yes)
 (<f> ^mode act ^busy no ^meal-window yes ^meal-due yes ^hunger { <h> < 101 } ^available <a>) (<a> ^kind eat)
 -->
 (<s> ^operator <o> +) (<o> ^name choose ^choice <a> ^priority (- 100 <h>) ^rule base*eat-when-hungry ^reason |肚子饿了，先吃饭。|)
}
sp {base*urgent-food
