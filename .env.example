# Node.js 22+. Copy this file to .env; keys are read on the server only.
PORT=3000
HOST=127.0.0.1
# manual: an operator/Codex writes replies to .runtime-inbox/*.reply.json
# compatible: call your own OpenAI-compatible /chat/completions provider
LLM_PROVIDER=manual
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_API_KEY=
LLM_JSON_MODE=true
LLM_MAX_OUTPUT_TOKENS=2800
LLM_TIMEOUT_MS=60000
LLM_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=4
